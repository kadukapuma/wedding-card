# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Supabase anonymous API key (Public client access, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY: Supabase service role key (CRITICAL: Private server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site URL for generating invitation links and Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
